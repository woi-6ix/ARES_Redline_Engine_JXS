//
// Lorentzian Classification concept and ML logic: © jdehorty
// ARES BBSR sequencing, confirmation engine, slope filter, visuals, alerts, and strategy integration: JXS

//@version=6
strategy(
     title="ARES Confirmation Engine Strategy v3 [BBSR + LC + Slope]",
     shorttitle="ARES Strategy v3",
     overlay=true,
     precision=4,
     pyramiding=0,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.0,
     process_orders_on_close=true,
     calc_on_every_tick=false,
     max_labels_count=500)

import jdehorty/MLExtensions/2 as ml

// ============================================================================
// ARES v3
// ============================================================================
//
// Sequence:
//
// BBSR BULL / BEAR arrow
//        ↓
// wait for user-selected number of CONFIRMATION BARS
//        ↓
// every confirmation bar must agree with:
//   1. Lorentzian Classification state
//   2. ATR-normalized price slope
//        ↓
// confirmed entry flag
//        ↓
// LC-style X exit
//
// Entries are only armed and confirmed from 09:30 to 15:00 America/New_York.
// Alerts fire ONLY on a completed ARES confirmation.
//
// ============================================================================

// ============================================================================
// 1. THEME
// ============================================================================

bullColor = #009988
bearColor = #CC3311
neutralColor = #787B86
transparent = color.new(#000000, 100)

// ============================================================================
// 2. BBSR
// ============================================================================

groupBBSR = "1. BBSR"

bbSrc = input.source(close, "Source", group=groupBBSR)
bbLength = input.int(20, "Bollinger Length", minval=1, group=groupBBSR)
bbMult = input.float(2.0, "Bollinger StdDev", minval=0.001, maxval=50, group=groupBBSR)

smoothK = input.int(3, "Stochastic K", minval=1, group=groupBBSR)
smoothD = input.int(3, "Stochastic D", minval=1, group=groupBBSR)
lengthRSI = input.int(14, "RSI Length", minval=1, group=groupBBSR)
lengthStoch = input.int(14, "Stochastic Length", minval=1, group=groupBBSR)

upperLimit = input.float(90.0, "Upper Extreme", minval=0, maxval=100, group=groupBBSR)
lowerLimit = input.float(10.0, "Lower Extreme", minval=0, maxval=100, group=groupBBSR)

showBBSRSignals = input.bool(true, "Show BBSR Arrows", group=groupBBSR)
showBollingerBands = input.bool(false, "Show Bollinger Bands", group=groupBBSR)

basis = ta.sma(bbSrc, bbLength)
dev = bbMult * ta.stdev(bbSrc, bbLength)
upper = basis + dev
lower = basis - dev

rsiBBSR = ta.rsi(bbSrc, lengthRSI)
stochRSI = ta.stoch(rsiBBSR, rsiBBSR, rsiBBSR, lengthStoch)
k = ta.sma(stochRSI, smoothK)
d = ta.sma(k, smoothD)

bbsrBear = close[1] > upper[1] and close < upper and k[1] > upperLimit and d[1] > upperLimit
bbsrBull = close[1] < lower[1] and close > lower and k[1] < lowerLimit and d[1] < lowerLimit

upperPlot = plot(showBollingerBands ? upper : na, title="BB Upper", color=color.new(neutralColor, 70))
lowerPlot = plot(showBollingerBands ? lower : na, title="BB Lower", color=color.new(neutralColor, 70))
plot(showBollingerBands ? basis : na, title="BB Basis", color=color.new(neutralColor, 45), linewidth=1)
fill(upperPlot, lowerPlot, title="BB Fill", color=showBollingerBands ? color.new(neutralColor, 96) : na)

// ============================================================================
// 3. TRADING SESSION
// ============================================================================

groupSession = "2. Trading Hours"

tradeSession = input.session("0930-1500", "Trading Window", group=groupSession)
inSession = not na(time(timeframe.period, tradeSession, "America/New_York"))
sessionJustEnded = not inSession and inSession[1]

// ============================================================================
// 4. LORENTZIAN CLASSIFICATION TYPES + HELPERS
// ============================================================================

type FeatureArrays
    array<float> f1
    array<float> f2
    array<float> f3
    array<float> f4
    array<float> f5

type FeatureSeries
    float f1
    float f2
    float f3
    float f4
    float f5

series_from(string featureString, float _close, float _high, float _low, float _hlc3, int paramA, int paramB) =>
    switch featureString
        "RSI" => ml.n_rsi(_close, paramA, paramB)
        "WT" => ml.n_wt(_hlc3, paramA, paramB)
        "CCI" => ml.n_cci(_close, paramA, paramB)
        "ADX" => ml.n_adx(_high, _low, _close, paramA)
        => ml.n_rsi(_close, paramA, paramB)

get_lorentzian_distance(int i, int featureCount, FeatureSeries fs, FeatureArrays fa) =>
    switch featureCount
        5 => math.log(1 + math.abs(fs.f1 - array.get(fa.f1, i))) + math.log(1 + math.abs(fs.f2 - array.get(fa.f2, i))) + math.log(1 + math.abs(fs.f3 - array.get(fa.f3, i))) + math.log(1 + math.abs(fs.f4 - array.get(fa.f4, i))) + math.log(1 + math.abs(fs.f5 - array.get(fa.f5, i)))
        4 => math.log(1 + math.abs(fs.f1 - array.get(fa.f1, i))) + math.log(1 + math.abs(fs.f2 - array.get(fa.f2, i))) + math.log(1 + math.abs(fs.f3 - array.get(fa.f3, i))) + math.log(1 + math.abs(fs.f4 - array.get(fa.f4, i)))
        3 => math.log(1 + math.abs(fs.f1 - array.get(fa.f1, i))) + math.log(1 + math.abs(fs.f2 - array.get(fa.f2, i))) + math.log(1 + math.abs(fs.f3 - array.get(fa.f3, i)))
        2 => math.log(1 + math.abs(fs.f1 - array.get(fa.f1, i))) + math.log(1 + math.abs(fs.f2 - array.get(fa.f2, i)))
        => 0.0

// ============================================================================
// 5. LC SETTINGS
// ============================================================================

groupLC = "3. Lorentzian Classification"

lcSource = input.source(close, "Source", group=groupLC)
neighborsCount = input.int(8, "Neighbors Count", minval=1, maxval=100, group=groupLC)
maxBarsBack = input.int(2000, "Max Bars Back", minval=100, group=groupLC)
featureCount = input.int(5, "Feature Count", minval=2, maxval=5, group=groupLC)
minPredictionStrength = input.float(0.0, "Minimum Prediction Strength", minval=0, step=1, group=groupLC)
includeFullHistory = input.bool(false, "Include Full History", group=groupLC)

groupFilters = "4. LC Filters"

useVolatilityFilter = input.bool(true, "Use Volatility Filter", group=groupFilters)
useRegimeFilter = input.bool(true, "Use Regime Filter", group=groupFilters)
regimeThreshold = input.float(-0.1, "Regime Threshold", minval=-10, maxval=10, step=0.1, group=groupFilters)

useADXFilter = input.bool(false, "Use ADX Filter", group=groupFilters)
adxThreshold = input.int(20, "ADX Threshold", minval=0, maxval=100, group=groupFilters)

useEMAFilter = input.bool(false, "Use EMA Filter", group=groupFilters)
emaPeriod = input.int(200, "EMA Period", minval=1, group=groupFilters)

useSMAFilter = input.bool(false, "Use SMA Filter", group=groupFilters)
smaPeriod = input.int(200, "SMA Period", minval=1, group=groupFilters)

groupFeatures = "5. LC Feature Engineering"

f1String = input.string("RSI", "Feature 1", options=["RSI", "WT", "CCI", "ADX"], group=groupFeatures)
f1A = input.int(14, "Feature 1 Parameter A", group=groupFeatures)
f1B = input.int(1, "Feature 1 Parameter B", group=groupFeatures)

f2String = input.string("WT", "Feature 2", options=["RSI", "WT", "CCI", "ADX"], group=groupFeatures)
f2A = input.int(10, "Feature 2 Parameter A", group=groupFeatures)
f2B = input.int(11, "Feature 2 Parameter B", group=groupFeatures)

f3String = input.string("CCI", "Feature 3", options=["RSI", "WT", "CCI", "ADX"], group=groupFeatures)
f3A = input.int(20, "Feature 3 Parameter A", group=groupFeatures)
f3B = input.int(1, "Feature 3 Parameter B", group=groupFeatures)

f4String = input.string("ADX", "Feature 4", options=["RSI", "WT", "CCI", "ADX"], group=groupFeatures)
f4A = input.int(20, "Feature 4 Parameter A", group=groupFeatures)
f4B = input.int(2, "Feature 4 Parameter B", group=groupFeatures)

f5String = input.string("RSI", "Feature 5", options=["RSI", "WT", "CCI", "ADX"], group=groupFeatures)
f5A = input.int(9, "Feature 5 Parameter A", group=groupFeatures)
f5B = input.int(1, "Feature 5 Parameter B", group=groupFeatures)

featureSeries = FeatureSeries.new(
     series_from(f1String, close, high, low, hlc3, f1A, f1B),
     series_from(f2String, close, high, low, hlc3, f2A, f2B),
     series_from(f3String, close, high, low, hlc3, f3A, f3B),
     series_from(f4String, close, high, low, hlc3, f4A, f4B),
     series_from(f5String, close, high, low, hlc3, f5A, f5B))

var f1Array = array.new_float()
var f2Array = array.new_float()
var f3Array = array.new_float()
var f4Array = array.new_float()
var f5Array = array.new_float()

array.push(f1Array, featureSeries.f1)
array.push(f2Array, featureSeries.f2)
array.push(f3Array, featureSeries.f3)
array.push(f4Array, featureSeries.f4)
array.push(f5Array, featureSeries.f5)

featureArrays = FeatureArrays.new(f1Array, f2Array, f3Array, f4Array, f5Array)

// ============================================================================
// 6. LC PREDICTION STATE
// ============================================================================

LONG_STATE = 1
SHORT_STATE = -1
NEUTRAL_STATE = 0

yTrainSeries = lcSource[4] < lcSource ? SHORT_STATE : lcSource[4] > lcSource ? LONG_STATE : NEUTRAL_STATE

var yTrainArray = array.new_int()
array.push(yTrainArray, yTrainSeries)

var predictions = array.new_float()
var distances = array.new_float()

array.clear(predictions)
array.clear(distances)

float lastDistance = -1.0

historySize = array.size(yTrainArray)
recentStart = math.max(0, historySize - maxBarsBack)
searchStart = includeFullHistory ? 0 : recentStart
searchEnd = historySize - 2

if historySize > 5 and searchEnd >= searchStart
    for i = searchStart to searchEnd
        currentDistance = get_lorentzian_distance(i, featureCount, featureSeries, featureArrays)
        if not na(currentDistance) and currentDistance >= lastDistance and i % 4 != 0
            lastDistance := currentDistance
            array.push(distances, currentDistance)
            array.push(predictions, float(array.get(yTrainArray, i)))

            if array.size(predictions) > neighborsCount
                qIndex = int(math.floor(neighborsCount * 0.75))
                qIndex := math.max(0, math.min(qIndex, array.size(distances) - 1))
                lastDistance := array.get(distances, qIndex)
                array.shift(distances)
                array.shift(predictions)

lcPrediction = array.size(predictions) > 0 ? array.sum(predictions) : 0.0

volatilityFilter = ml.filter_volatility(1, 10, useVolatilityFilter)
regimeFilter = ml.regime_filter(ohlc4, regimeThreshold, useRegimeFilter)
adxFilter = ml.filter_adx(lcSource, 14, adxThreshold, useADXFilter)

filterAll = volatilityFilter and regimeFilter and adxFilter

var int lcState = NEUTRAL_STATE

if lcPrediction > 0 and filterAll
    lcState := LONG_STATE
else if lcPrediction < 0 and filterAll
    lcState := SHORT_STATE
else
    lcState := nz(lcState[1], NEUTRAL_STATE)

ema = ta.ema(close, emaPeriod)
sma = ta.sma(close, smaPeriod)

emaBull = not useEMAFilter or close > ema
emaBear = not useEMAFilter or close < ema
smaBull = not useSMAFilter or close > sma
smaBear = not useSMAFilter or close < sma

lcBullConfirmed = lcState == LONG_STATE and math.abs(lcPrediction) >= minPredictionStrength and emaBull and smaBull
lcBearConfirmed = lcState == SHORT_STATE and math.abs(lcPrediction) >= minPredictionStrength and emaBear and smaBear

// ============================================================================
// 7. SLOPE CONFIRMATION
// ============================================================================

groupSlope = "6. Confirmation Slope"

slopeLookback = input.int(5, "Slope Lookback", minval=2, maxval=50, group=groupSlope)
minSlopeStrength = input.float(0.05, "Minimum ATR-Normalized Slope", minval=0, step=0.01, group=groupSlope)

regressionNow = ta.linreg(close, slopeLookback, 0)
regressionPrevious = ta.linreg(close, slopeLookback, 1)
priceSlope = regressionNow - regressionPrevious

slopeATR = ta.atr(14)
normalizedSlope = slopeATR > 0 ? priceSlope / slopeATR : 0.0

bullSlopeConfirmed = normalizedSlope >= minSlopeStrength
bearSlopeConfirmed = normalizedSlope <= -minSlopeStrength

// ============================================================================
// 8. ARES CONFIRMATION ENGINE
// ============================================================================

groupARES = "7. ARES Confirmation"

confirmationBarsRequired = input.int(
     2,
     "Required Consecutive Confirmation Bars",
     minval=1,
     maxval=20,
     group=groupARES,
     tooltip="After a BBSR arrow, every confirmation bar must have matching LC state and matching slope.")

maxBarsToConfirm = input.int(
     12,
     "Maximum Bars To Confirm",
     minval=1,
     maxval=100,
     group=groupARES)

showConfirmationBars = input.bool(
     true,
     "Highlight Valid Confirmation Bars",
     group=groupARES)

var int armedDirection = NEUTRAL_STATE
var int armedBar = na
var int confirmationCount = 0

var int activeTrade = NEUTRAL_STATE
var int entryBar = na

// Only a BBSR arrow inside the session can arm ARES.
// New setups are ignored while a trade is active.
if barstate.isconfirmed and inSession and activeTrade == NEUTRAL_STATE
    if bbsrBull
        armedDirection := LONG_STATE
        armedBar := bar_index
        confirmationCount := 0
    else if bbsrBear
        armedDirection := SHORT_STATE
        armedBar := bar_index
        confirmationCount := 0

setupAge = not na(armedBar) ? bar_index - armedBar : na

if armedDirection != NEUTRAL_STATE and not na(setupAge) and setupAge > maxBarsToConfirm
    armedDirection := NEUTRAL_STATE
    armedBar := na
    confirmationCount := 0

if not inSession and activeTrade == NEUTRAL_STATE
    armedDirection := NEUTRAL_STATE
    armedBar := na
    confirmationCount := 0

bullConfirmationBar =
     barstate.isconfirmed and
     inSession and
     activeTrade == NEUTRAL_STATE and
     armedDirection == LONG_STATE and
     not na(armedBar) and
     bar_index > armedBar and
     lcBullConfirmed and
     bullSlopeConfirmed

bearConfirmationBar =
     barstate.isconfirmed and
     inSession and
     activeTrade == NEUTRAL_STATE and
     armedDirection == SHORT_STATE and
     not na(armedBar) and
     bar_index > armedBar and
     lcBearConfirmed and
     bearSlopeConfirmed

if armedDirection == LONG_STATE and not na(armedBar) and bar_index > armedBar
    if bullConfirmationBar
        confirmationCount += 1
    else
        confirmationCount := 0

if armedDirection == SHORT_STATE and not na(armedBar) and bar_index > armedBar
    if bearConfirmationBar
        confirmationCount += 1
    else
        confirmationCount := 0

aresBuy =
     activeTrade == NEUTRAL_STATE and
     armedDirection == LONG_STATE and
     confirmationCount >= confirmationBarsRequired and
     bullConfirmationBar

aresSell =
     activeTrade == NEUTRAL_STATE and
     armedDirection == SHORT_STATE and
     confirmationCount >= confirmationBarsRequired and
     bearConfirmationBar

// Entry timing is tied directly to the completed ARES signal.
// There is NO additional line-cross requirement after confirmation.
aresLongSignal = aresBuy
aresShortSignal = aresSell

// ============================================================================
// 9. LC-STYLE TRADE LIFECYCLE + X EXITS
// ============================================================================

groupExit = "8. LC-Style Exits"

exitBars = input.int(
     4,
     "Maximum Trade Bars",
     minval=1,
     maxval=100,
     group=groupExit,
     tooltip="The original LC model is trained around a four-bar horizon, so 4 is the default.")

exitOnOppositeLC = input.bool(
     true,
     "Exit Early On Opposite LC State",
     group=groupExit)

exitAtSessionEnd = input.bool(
     true,
     "Exit At 3:00 PM",
     group=groupExit)

tradeAge = activeTrade != NEUTRAL_STATE and not na(entryBar) ? bar_index - entryBar : na

endLongTrade =
     activeTrade == LONG_STATE and
     (
         (not na(tradeAge) and tradeAge >= exitBars) or
         (exitOnOppositeLC and lcBearConfirmed) or
         (exitAtSessionEnd and sessionJustEnded)
     )

endShortTrade =
     activeTrade == SHORT_STATE and
     (
         (not na(tradeAge) and tradeAge >= exitBars) or
         (exitOnOppositeLC and lcBullConfirmed) or
         (exitAtSessionEnd and sessionJustEnded)
     )

isEarlySignalFlip =
     (activeTrade == LONG_STATE and not na(tradeAge) and tradeAge < exitBars and lcBearConfirmed) or
     (activeTrade == SHORT_STATE and not na(tradeAge) and tradeAge < exitBars and lcBullConfirmed)

// ============================================================================
// 9A. STRATEGY ORDERS
// ============================================================================
//
// Entries occur only after the requested BBSR -> LC + slope confirmation bars.
// Exits use the same LC-style X conditions shown on the chart.
//

if endLongTrade
    strategy.close("ARES LONG", comment="ARES X")

if endShortTrade
    strategy.close("ARES SHORT", comment="ARES X")

if aresLongSignal
    strategy.entry("ARES LONG", strategy.long, comment="ARES BUY")

if aresShortSignal
    strategy.entry("ARES SHORT", strategy.short, comment="ARES SELL")

// Exit first.
if endLongTrade or endShortTrade
    activeTrade := NEUTRAL_STATE
    entryBar := na

// Then accept a newly confirmed ARES entry.
if aresBuy
    activeTrade := LONG_STATE
    entryBar := bar_index
    armedDirection := NEUTRAL_STATE
    armedBar := na
    confirmationCount := 0

if aresSell
    activeTrade := SHORT_STATE
    entryBar := bar_index
    armedDirection := NEUTRAL_STATE
    armedBar := na
    confirmationCount := 0

// ============================================================================
// 10. LC-STYLE VISUALS
// ============================================================================

plotshape(
     showBBSRSignals and inSession and bbsrBull,
     title="BBSR Bull",
     style=shape.triangleup,
     location=location.belowbar,
     color=bullColor,
     size=size.tiny,
     text="B",
     textcolor=color.black)

plotshape(
     showBBSRSignals and inSession and bbsrBear,
     title="BBSR Bear",
     style=shape.triangledown,
     location=location.abovebar,
     color=bearColor,
     size=size.tiny,
     text="B",
     textcolor=color.white)

plotshape(
     aresLongSignal,
     title="ARES Buy Flag",
     style=shape.flag,
     location=location.belowbar,
     color=bullColor,
     size=size.small,
     text="BUY",
     textcolor=color.black)

plotshape(
     aresShortSignal,
     title="ARES Sell Flag",
     style=shape.flag,
     location=location.abovebar,
     color=bearColor,
     size=size.small,
     text="SELL",
     textcolor=color.white)

plotshape(
     endLongTrade,
     title="ARES Exit Long",
     style=shape.xcross,
     location=location.abovebar,
     color=bullColor,
     size=size.small)

plotshape(
     endShortTrade,
     title="ARES Exit Short",
     style=shape.xcross,
     location=location.belowbar,
     color=bearColor,
     size=size.small)

confirmationBarColor =
     bullConfirmationBar ? color.new(bullColor, 55) :
     bearConfirmationBar ? color.new(bearColor, 55) :
     na

barcolor(showConfirmationBars ? confirmationBarColor : na)

plot(useEMAFilter ? ema : na, title="LC EMA", color=color.new(neutralColor, 25))
plot(useSMAFilter ? sma : na, title="LC SMA", color=color.new(neutralColor, 55))

// ============================================================================
// 11. SINGLE ENTRY ALERT
// ============================================================================
//
// Create ONE TradingView alert:
// Condition -> ARES Confirmation Engine Strategy v3 -> Any alert() function call
//
// It only fires AFTER all requested confirmation bars have passed BOTH
// the LC-state filter and slope filter.
//

if aresLongSignal
    alert(
         "ARES BUY | " +
         syminfo.ticker +
         " | " +
         timeframe.period +
         " | " +
         str.tostring(confirmationBarsRequired) +
         " confirmation bars complete | Price: " +
         str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)

else if aresShortSignal
    alert(
         "ARES SELL | " +
         syminfo.ticker +
         " | " +
         timeframe.period +
         " | " +
         str.tostring(confirmationBarsRequired) +
         " confirmation bars complete | Price: " +
         str.tostring(close, format.mintick),
         alert.freq_once_per_bar_close)

// ============================================================================
// 12. LC TRADE STATS
// ============================================================================

groupStats = "9. LC Trade Stats"

showTradeStats = input.bool(
     true,
     "Show Trade Stats",
     group=groupStats,
     tooltip="Calibration statistics in the same style as Lorentzian Classification. Not a replacement for full strategy backtesting.")

useWorstCase = input.bool(
     false,
     "Use Worst Case Estimates",
     group=groupStats)

maxBarsBackIndex = last_bar_index >= maxBarsBack ? last_bar_index - maxBarsBack : 0

[totalWins, totalLosses, totalEarlySignalFlips, totalTrades, tradeStatsHeader, winLossRatio, winRate] = ml.backtest(high, low, open, aresLongSignal, endLongTrade, aresShortSignal, endShortTrade, isEarlySignalFlip, maxBarsBackIndex, bar_index, lcSource, useWorstCase)

var table statsTable = table.new(
     position.top_right,
     columns=2,
     rows=7,
     frame_color=color.new(color.black, 100),
     frame_width=1,
     border_width=1,
     border_color=color.new(color.black, 100))

if barstate.islast and showTradeStats
    winRateText = totalTrades > 0 ? str.tostring(totalWins / totalTrades, "#.#%") : "N/A"
    tradeText = str.tostring(totalTrades, "#") + " (" + str.tostring(totalWins, "#") + "|" + str.tostring(totalLosses, "#") + ")"
    wlText = totalLosses > 0 ? str.tostring(totalWins / totalLosses, "0.00") : totalWins > 0 ? "∞" : "N/A"
    lcStateText = lcBullConfirmed ? "BULL" : lcBearConfirmed ? "BEAR" : "NEUTRAL"
    lcStateColor = lcBullConfirmed ? bullColor : lcBearConfirmed ? bearColor : neutralColor

    table.cell(statsTable, 0, 0, "ARES / LC", text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
    table.cell(statsTable, 1, 0, tradeStatsHeader, text_halign=text.align_center, text_color=color.gray, text_size=size.normal)

    table.cell(statsTable, 0, 1, "Winrate", text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
    table.cell(statsTable, 1, 1, winRateText, text_halign=text.align_center, text_color=color.gray, text_size=size.normal)

    table.cell(statsTable, 0, 2, "Trades", text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
    table.cell(statsTable, 1, 2, tradeText, text_halign=text.align_center, text_color=color.gray, text_size=size.normal)

    table.cell(statsTable, 0, 3, "WL Ratio", text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
    table.cell(statsTable, 1, 3, wlText, text_halign=text.align_center, text_color=color.gray, text_size=size.normal)

    table.cell(statsTable, 0, 4, "Early Flips", text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
    table.cell(statsTable, 1, 4, str.tostring(totalEarlySignalFlips, "#"), text_halign=text.align_center, text_color=color.gray, text_size=size.normal)

    table.cell(statsTable, 0, 5, "LC State", text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
    table.cell(statsTable, 1, 5, lcStateText, text_halign=text.align_center, text_color=lcStateColor, text_size=size.normal)

    table.cell(statsTable, 0, 6, "Confirm", text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
    table.cell(statsTable, 1, 6, str.tostring(confirmationCount) + "/" + str.tostring(confirmationBarsRequired), text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
