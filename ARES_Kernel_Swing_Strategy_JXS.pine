// Kernel regression and color logic adapted from Lorentzian Classification: © jdehorty.
// ARES strategy, order rules, and trade panel: JXS.

//@version=6
strategy("ARES Kernel Swing Strategy [JXS]", shorttitle="ARES Kernel Swing", overlay=true,
     precision=4, pyramiding=0, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0,
     process_orders_on_close=true, calc_on_every_tick=false)

import jdehorty/KernelFunctions/2 as kernels

// The source, kernel settings, smoothing option, and colors match the
// kernel line in jdehorty's Lorentzian Classification indicator.
groupKernel = "1. Kernel Line"
src = input.source(close, "Source", group=groupKernel)
h = input.int(8, "Lookback Window", minval=3, group=groupKernel)
r = input.float(8.0, "Relative Weighting", minval=0.25, step=0.25, group=groupKernel)
x = input.int(25, "Regression Level", minval=2, group=groupKernel)
useKernelSmoothing = input.bool(false, "Enhance Kernel Smoothing", group=groupKernel,
     tooltip="Use Gaussian/rational-quadratic comparisons for color, as in LC. Off uses the rational-quadratic line's slope.")
lag = input.int(2, "Lag", minval=1, maxval=2, group=groupKernel)

groupTrading = "2. Trading Hours"
tradeSession = input.session("0930-1500:23456", "New entry window (New York)", group=groupTrading)
// Existing positions remain open beyond 15:00 until an opposite color change
// or, when enabled, an R bracket fills. Exits can occur outside the window.

groupConfirmation = "3. Entry Confirmation"
confirmationBars = input.int(4, "Consecutive color bars", minval=1, group=groupConfirmation,
     tooltip="The color-change bar counts as bar 1. Default 4 means the kernel must remain in the new direction for more than 3 completed bars before entry.")

groupRisk = "4. Optional R Target"
useRTarget = input.bool(false, "Use stop and R target", group=groupRisk,
     tooltip="Off: hold until the opposite kernel color change. On: place a fixed ATR stop and a target at the chosen multiple of that risk. No repeat entry until another color change.")
atrLength = input.int(14, "ATR Length", minval=1, group=groupRisk)
stopAtrMultiplier = input.float(1.0, "Stop distance (ATR)", minval=0.1, step=0.1, group=groupRisk)
rewardMultiple = input.float(2.0, "Profit target (R)", minval=0.25, step=0.25, group=groupRisk)

groupDisplay = "5. Display"
showTradeStats = input.bool(true, "Show LC-style trade stats", group=groupDisplay)
showSignals = input.bool(true, "Show entry markers", group=groupDisplay)
showRiskLevels = input.bool(false, "Show active stop / target", group=groupDisplay)

bullColor = #009988
bearColor = #CC3311
neutralColor = color.gray
clearColor = color.new(color.black, 100)

yhat1 = kernels.rationalQuadratic(src, h, r, x)
yhat2 = kernels.gaussian(src, h - lag, x)
kernelReady = not na(yhat1) and not na(yhat1[1]) and (not useKernelSmoothing or not na(yhat2))
// LC's unsmoothed plot is green when the line rises; otherwise it is red.
isBullish = kernelReady and (useKernelSmoothing ? yhat2 >= yhat1 : yhat1 > yhat1[1])
isBearish = kernelReady and not isBullish
bullishFlip = isBullish and not isBullish[1] and kernelReady[1]
bearishFlip = isBearish and not isBearish[1] and kernelReady[1]
plot(yhat1, "Kernel Regression Estimate", color=kernelReady ? (isBullish ? bullColor : bearColor) : na, linewidth=2)

// Check the bar's opening and closing times so a bar that closes after 15:00
// cannot open a new position. America/New_York follows daylight saving time.
inSession = timeframe.isintraday and not na(time(timeframe.period, tradeSession, "America/New_York"))
sessionClose = time_close(timeframe.period, tradeSession, "America/New_York")
entryWindow = inSession and not na(sessionClose) and time_close <= sessionClose

// 1R is fixed at the signal bar's ATR distance. With process_orders_on_close,
// the strategy entry fills at the confirmation bar's close in the emulator.
riskDistance = math.max(ta.atr(atrLength) * stopAtrMultiplier, syminfo.mintick)
var float activeStop = na
var float activeTarget = na
var int lastEntryBar = na
var int earlyColorFlips = 0
var int pendingDirection = 0
var int confirmationCount = 0

// Arm only when the color changes within the entry window. Count completed
// bars in that color, including the flip bar; cancel if color or session ends.
if barstate.isconfirmed
    if bullishFlip
        pendingDirection := entryWindow ? 1 : 0
        confirmationCount := entryWindow ? 1 : 0
    else if bearishFlip
        pendingDirection := entryWindow ? -1 : 0
        confirmationCount := entryWindow ? 1 : 0
    else if pendingDirection != 0
        if not entryWindow or (pendingDirection == 1 and not isBullish) or (pendingDirection == -1 and not isBearish)
            pendingDirection := 0
            confirmationCount := 0
        else
            confirmationCount += 1

longSignal = barstate.isconfirmed and pendingDirection == 1 and confirmationCount == confirmationBars and not na(riskDistance)
shortSignal = barstate.isconfirmed and pendingDirection == -1 and confirmationCount == confirmationBars and not na(riskDistance)

if barstate.isconfirmed
    // A color flip exits the old trade immediately. Only a confirmed new
    // direction opens a position; with one-bar confirmation, entry reverses.
    if bullishFlip and strategy.position_size < 0
        if not na(lastEntryBar) and bar_index - lastEntryBar < 4
            earlyColorFlips += 1
        if not longSignal
            strategy.close("Short", comment="Green kernel", alert_message="ARES KERNEL SHORT COLOR EXIT")
            activeStop := na
            activeTarget := na
    if bearishFlip and strategy.position_size > 0
        if not na(lastEntryBar) and bar_index - lastEntryBar < 4
            earlyColorFlips += 1
        if not shortSignal
            strategy.close("Long", comment="Red kernel", alert_message="ARES KERNEL LONG COLOR EXIT")
            activeStop := na
            activeTarget := na

    if longSignal
        strategy.entry("Long", strategy.long, alert_message="ARES KERNEL BUY")
        activeStop := useRTarget ? close - riskDistance : na
        activeTarget := useRTarget ? close + riskDistance * rewardMultiple : na
        lastEntryBar := bar_index
        if useRTarget
            strategy.exit("Long R Exit", from_entry="Long", stop=activeStop, limit=activeTarget,
                 alert_message="ARES KERNEL LONG R EXIT")
    if shortSignal
        strategy.entry("Short", strategy.short, alert_message="ARES KERNEL SELL")
        activeStop := useRTarget ? close + riskDistance : na
        activeTarget := useRTarget ? close - riskDistance * rewardMultiple : na
        lastEntryBar := bar_index
        if useRTarget
            strategy.exit("Short R Exit", from_entry="Short", stop=activeStop, limit=activeTarget,
                 alert_message="ARES KERNEL SHORT R EXIT")
    if longSignal or shortSignal
        pendingDirection := 0
        confirmationCount := 0

// Keep levels visible only while the trade is open. If a bracket fills, wait
// for the next genuine color change before taking another trade.
if strategy.position_size == 0 and strategy.position_size[1] != 0 and not longSignal and not shortSignal
    activeStop := na
    activeTarget := na

plot(showRiskLevels and useRTarget and strategy.position_size != 0 ? activeStop : na,
     "Fixed stop", color=bearColor, style=plot.style_linebr)
plot(showRiskLevels and useRTarget and strategy.position_size != 0 ? activeTarget : na,
     "Fixed R target", color=bullColor, style=plot.style_linebr)
plotshape(showSignals and longSignal and not na(riskDistance), title="Kernel long entry",
     style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.tiny, text="L")
plotshape(showSignals and shortSignal and not na(riskDistance), title="Kernel short entry",
     style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.tiny, text="S")

// Same compact position, normal font, neutral borders, and teal/red theme as
// the LC trade box. Figures here use actual Strategy Tester closed trades.
if showTradeStats
    var table statsTable = table.new(position.top_right, columns=2, rows=8,
         frame_color=clearColor, frame_width=1, border_width=1, border_color=clearColor)
    if barstate.islast
        closed = strategy.closedtrades
        wins = strategy.wintrades
        losses = strategy.losstrades
        winRate = closed > 0 ? str.tostring(wins / closed, "#.#%") : "—"
        wlRatio = losses > 0 ? str.tostring(wins / losses, "0.00") : "—"
        profitFactor = strategy.grossloss < 0 ? str.tostring(strategy.grossprofit / math.abs(strategy.grossloss), "0.00") : "—"
        table.cell(statsTable, 0, 0, "ARES Kernel", text_halign=text.align_center, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 1, 0, useRTarget ? str.tostring(rewardMultiple, "0.##") + "R" : "Color exit",
             text_halign=text.align_center, text_color=isBullish ? bullColor : bearColor, text_size=size.normal)
        table.cell(statsTable, 0, 1, "Winrate", text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 1, 1, winRate, text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 0, 2, "Trades", text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 1, 2, str.tostring(closed) + " (" + str.tostring(wins) + "|" + str.tostring(losses) + ")", text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 0, 3, "Net P&L", text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 1, 3, str.tostring(strategy.netprofit, "#.##"), text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 0, 4, "Profit Factor", text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 1, 4, profitFactor, text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 0, 5, "WL Ratio", text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 1, 5, wlRatio, text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 0, 6, "Early Color Flips", text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 1, 6, str.tostring(earlyColorFlips), text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 0, 7, "Confirm", text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
        table.cell(statsTable, 1, 7, pendingDirection == 0 ? "—" : (pendingDirection == 1 ? "Bull " : "Bear ") + str.tostring(confirmationCount) + "/" + str.tostring(confirmationBars), text_halign=text.align_center, bgcolor=clearColor, text_color=neutralColor, text_size=size.normal)
